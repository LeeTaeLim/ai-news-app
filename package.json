{
  "name": "ai-news-collector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "node --use-system-ca node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "db:generate": "node --use-system-ca node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --use-system-ca node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node --use-system-ca node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --use-system-ca node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@clerk/localizations": "^4.20.0",
    "@clerk/nextjs": "^7.9.14",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
